        <mxCell id="qap7HcMgnzMG2VSK3jr8-11" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;background-color: rgb(255, 255, 255); font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; line-height: 19px; white-space: pre;&quot;&gt;&lt;span style=&quot;color: rgb(15, 17, 21); font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Open Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; font-variant-ligatures: no-contextual; text-align: start; white-space: pre-wrap; background-color: rgb(237, 243, 254);&quot;&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;init_vmlinux_build_id();&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
