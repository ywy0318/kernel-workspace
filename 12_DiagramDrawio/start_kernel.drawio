        <mxCell id="Sgn_1HDSBjQnMq3442AB-74" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;color: rgb(0, 0, 0); background-color: rgb(255, 255, 255); font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-weight: normal; line-height: 19px; white-space: pre;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;poking_init();&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="40" width="140" x="1272.5" y="3435" as="geometry" />
        </mxCell>
        <mxCell id="Sgn_1HDSBjQnMq3442AB-75" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;p class=&quot;ds-markdown-paragraph&quot; style=&quot;margin-right: 0px; margin-bottom: 16px; margin-left: 0px; color: rgb(15, 17, 21); font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Open Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; margin-top: 0px !important;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;span class=&quot;&quot; style=&quot;&quot;&gt;为内核的“运行时指令修补”（text poking）功能准备一个专用的内存空间&lt;/span&gt;&lt;span class=&quot;&quot; style=&quot;&quot;&gt;。&lt;/span&gt;&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p class=&quot;ds-markdown-paragraph&quot; style=&quot;margin: 16px 0px; color: rgb(15, 17, 21); font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Open Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;span class=&quot;&quot; style=&quot;&quot;&gt;这个功能允许内核在系统运行时，安全地修改自身的代码段（例如，用于&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;code style=&quot;box-sizing: border-box; font-style: normal; font-variant: normal; font-stretch: 100%; line-height: 22px; font-optical-sizing: auto; font-size-adjust: none; font-kerning: auto; font-feature-settings: normal; font-variation-settings: normal; font-language-override: normal; font-family: Menlo, Monaco, Consolas, &amp;quot;Cascadia Mono&amp;quot;, &amp;quot;Ubuntu Mono&amp;quot;, &amp;quot;DejaVu Sans Mono&amp;quot;, &amp;quot;Liberation Mono&amp;quot;, &amp;quot;JetBrains Mono&amp;quot;, &amp;quot;Fira Code&amp;quot;, Cousine, &amp;quot;Roboto Mono&amp;quot;, &amp;quot;Courier New&amp;quot;, Courier, sans-serif, system-ui; background-color: rgb(235, 238, 242); border-radius: 6px; align-items: center; padding: 0px 5px; display: inline-flex;&quot;&gt;ftrace&lt;/code&gt;&lt;span class=&quot;&quot; style=&quot;&quot;&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;动态跟踪或&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;code style=&quot;box-sizing: border-box; font-style: normal; font-variant: normal; font-stretch: 100%; line-height: 22px; font-optical-sizing: auto; font-size-adjust: none; font-kerning: auto; font-feature-settings: normal; font-variation-settings: normal; font-language-override: normal; font-family: Menlo, Monaco, Consolas, &amp;quot;Cascadia Mono&amp;quot;, &amp;quot;Ubuntu Mono&amp;quot;, &amp;quot;DejaVu Sans Mono&amp;quot;, &amp;quot;Liberation Mono&amp;quot;, &amp;quot;JetBrains Mono&amp;quot;, &amp;quot;Fira Code&amp;quot;, Cousine, &amp;quot;Roboto Mono&amp;quot;, &amp;quot;Courier New&amp;quot;, Courier, sans-serif, system-ui; background-color: rgb(235, 238, 242); border-radius: 6px; align-items: center; padding: 0px 5px; display: inline-flex;&quot;&gt;kprobes&lt;/code&gt;&lt;span class=&quot;&quot; style=&quot;&quot;&gt;&amp;nbsp;动态探针）。&lt;/span&gt;&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="820" x="340" y="3425" as="geometry" />
        </mxCell>
        <mxCell id="Sgn_1HDSBjQnMq3442AB-76" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;color: rgb(0, 0, 0); background-color: rgb(255, 255, 255); font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-weight: normal; line-height: 19px; white-space: pre;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;ftrace_init();&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="40" width="140" x="1287.5" y="3575" as="geometry" />
        </mxCell>
        <mxCell id="Sgn_1HDSBjQnMq3442AB-77" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;b&gt;&lt;span class=&quot;&quot; style=&quot;color: rgb(15, 17, 21); font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Open Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;是 Linux 内核中&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(15, 17, 21); font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Open Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;span class=&quot;&quot;&gt;Ftrace&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;&quot; style=&quot;color: rgb(15, 17, 21); font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Open Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;（Function Tracer）跟踪机制的核心初始化函数。它的主要任务是&lt;/span&gt;&lt;span style=&quot;color: rgb(15, 17, 21); font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Open Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;span class=&quot;&quot;&gt;解析并准备内核中所有可用于跟踪的函数入口点&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;&quot; style=&quot;color: rgb(15, 17, 21); font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Open Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;，为后续的跟踪功能（如动态函数跟踪）建立基础数据。&lt;/span&gt;&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="815" x="350" y="3565" as="geometry" />
        </mxCell>
        <mxCell id="Sgn_1HDSBjQnMq3442AB-78" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;color: rgb(0, 0, 0); background-color: rgb(255, 255, 255); font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-weight: normal; line-height: 19px; white-space: pre;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="40" width="210" x="1252.5" y="3665" as="geometry" />
        </mxCell>
        <mxCell id="Sgn_1HDSBjQnMq3442AB-79" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;color: rgb(0, 0, 0); background-color: rgb(255, 255, 255); font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-weight: normal; line-height: 19px; white-space: pre;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;early_trace_init();&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="40" width="180" x="1267.5" y="3695" as="geometry" />
        </mxCell>
        <mxCell id="Sgn_1HDSBjQnMq3442AB-80" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;p class=&quot;ds-markdown-paragraph&quot; style=&quot;margin-right: 0px; margin-bottom: 16px; margin-left: 0px; color: rgb(15, 17, 21); font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Open Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; margin-top: 0px !important;&quot;&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;b&gt;&lt;span class=&quot;&quot; style=&quot;&quot;&gt;将跟踪（tracing）子系统的初始化过程拆分成两个阶段，它负责第一阶段，即极早期的初始化&lt;/span&gt;&lt;span class=&quot;&quot; style=&quot;&quot;&gt;。&lt;/span&gt;&lt;span class=&quot;&quot; style=&quot;color: light-dark(rgb(15, 17, 21), rgb(222, 223, 227));&quot;&gt;这个函数的核心目标是&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(15, 17, 21), rgb(222, 223, 227));&quot;&gt;&lt;span class=&quot;&quot; style=&quot;&quot;&gt;尽早初始化跟踪缓冲区，使开发者可以在内核启动的极早阶段就使用&amp;nbsp;&lt;/span&gt;&lt;code style=&quot;box-sizing: border-box; font-variant: normal; font-stretch: 100%; line-height: 22px; font-optical-sizing: auto; font-size-adjust: none; font-kerning: auto; font-feature-settings: normal; font-variation-settings: normal; font-language-override: normal; font-family: Menlo, Monaco, Consolas, &amp;quot;Cascadia Mono&amp;quot;, &amp;quot;Ubuntu Mono&amp;quot;, &amp;quot;DejaVu Sans Mono&amp;quot;, &amp;quot;Liberation Mono&amp;quot;, &amp;quot;JetBrains Mono&amp;quot;, &amp;quot;Fira Code&amp;quot;, Cousine, &amp;quot;Roboto Mono&amp;quot;, &amp;quot;Courier New&amp;quot;, Courier, sans-serif, system-ui; background-color: rgb(235, 238, 242); border-radius: 6px; align-items: center; padding: 0px 5px; display: inline-flex;&quot;&gt;trace_printk()&lt;/code&gt;&lt;span class=&quot;&quot; style=&quot;&quot;&gt;&amp;nbsp;进行调试&lt;/span&gt;&lt;/span&gt;&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="782.5" x="335" y="3685" as="geometry" />
        </mxCell>
        <mxCell id="Sgn_1HDSBjQnMq3442AB-81" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;color: rgb(0, 0, 0); background-color: rgb(255, 255, 255); font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-weight: normal; line-height: 19px; white-space: pre;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;sched_init();&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="40" width="130" x="1310" y="3825" as="geometry" />
        </mxCell>
        <mxCell id="Sgn_1HDSBjQnMq3442AB-82" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;p class=&quot;ds-markdown-paragraph&quot; style=&quot;margin-right: 0px; margin-bottom: 16px; margin-left: 0px; color: rgb(15, 17, 21); font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Open Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; margin-top: 0px !important;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;span class=&quot;&quot; style=&quot;&quot;&gt;Linux 内核中&lt;/span&gt;&lt;span class=&quot;&quot; style=&quot;&quot;&gt;进程调度器（Scheduler）子系统&lt;/span&gt;&lt;span class=&quot;&quot; style=&quot;&quot;&gt;的核心初始化函数。它的主要任务是为系统的&lt;/span&gt;&lt;span class=&quot;&quot; style=&quot;&quot;&gt;任务调度&lt;/span&gt;&lt;span class=&quot;&quot; style=&quot;&quot;&gt;建立完整的数据结构和管理框架。&lt;/span&gt;&lt;/font&gt;&lt;/b&gt;&lt;b style=&quot;color: light-dark(rgb(15, 17, 21), rgb(222, 223, 227));&quot;&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;span class=&quot;&quot;&gt;简单来说，&lt;/span&gt;&lt;span class=&quot;&quot;&gt;没有它，内核就永远无法进行进程切换，系统只能停滞在单线程执行的状态&lt;/span&gt;&lt;span class=&quot;&quot;&gt;。&lt;/span&gt;&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="130" width="792.5" x="350" y="3805" as="geometry" />
        </mxCell>
        <mxCell id="Sgn_1HDSBjQnMq3442AB-83" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;color: rgb(0, 0, 0); background-color: rgb(255, 255, 255); font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-weight: normal; line-height: 19px; white-space: pre;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;radix_tree_init();&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="40" width="260" x="1310" y="3975" as="geometry" />
        </mxCell>
        <UserObject label="&lt;p class=&quot;ds-markdown-paragraph&quot; style=&quot;margin-right: 0px; margin-bottom: 16px; margin-left: 0px; color: rgb(15, 17, 21); font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Open Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; margin-top: 0px !important;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;span class=&quot;&quot; style=&quot;&quot;&gt;Linux 内核中&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;&quot; style=&quot;&quot;&gt;Radix Tree（基树）数据结构的初始化函数&lt;/span&gt;&lt;font color=&quot;rgba(0, 0, 0, 0)&quot; style=&quot;&quot;&gt;&lt;span style=&quot;transition: box-shadow 0.2s cubic-bezier(0.4, 0, 0.2, 1); border-style: solid; border-color: light-dark(rgba(255, 255, 255, 0), rgba(18, 18, 18, 0)); border-image: none; border-width: 2px 3px; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;a href=&quot;https://blog.csdn.net/weifenghai/article/details/53113395#1&quot; target=&quot;_blank&quot; rel=&quot;noreferrer&quot; style=&quot;color: rgb(57, 100, 254); transition: box-shadow 0.2s cubic-bezier(0.4, 0, 0.2, 1); border-style: solid; border-color: rgba(255, 255, 255, 0); border-image: none; border-width: 2px 3px; margin-left: -3px; margin-right: -3px; text-decoration: none; position: relative; cursor: default;&quot;&gt;&lt;/a&gt;&lt;/span&gt;&lt;/font&gt;&lt;span class=&quot;&quot; style=&quot;&quot;&gt;。&lt;/span&gt;&lt;span class=&quot;&quot; style=&quot;color: light-dark(rgb(15, 17, 21), rgb(222, 223, 227));&quot;&gt;它的核心作用是&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(15, 17, 21), rgb(222, 223, 227));&quot;&gt;&lt;span class=&quot;&quot; style=&quot;&quot;&gt;为 Radix Tree 的节点对象创建一个专用的内存缓存（slab cache），并初始化其内部管理结构，为后续内核使用 Radix Tree 管理数据做好准备&lt;/span&gt;&lt;/span&gt;&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;" link="&lt;p class=&quot;ds-markdown-paragraph&quot; style=&quot;margin-top: 0px !important; margin-right: 0px; margin-bottom: 16px; margin-left: 0px; color: rgb(15, 17, 21); font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Open Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;span class=&quot;&quot;&gt;Linux 内核中&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;strong style=&quot;font-weight: 600;&quot;&gt;&lt;span class=&quot;&quot;&gt;Radix Tree（基树）数据结构的初始化函数&lt;/span&gt;&lt;/strong&gt;&lt;a href=&quot;https://blog.csdn.net/weifenghai/article/details/53113395#1&quot; target=&quot;_blank&quot; rel=&quot;noreferrer&quot; style=&quot;color: rgb(57, 100, 254); transition: box-shadow 0.2s cubic-bezier(0.4, 0, 0.2, 1); border-style: solid; border-color: rgba(255, 255, 255, 0); border-image: none; border-width: 2px 3px; margin-left: -3px; margin-right: -3px; text-decoration: none; position: relative; cursor: default;&quot;&gt;&lt;/a&gt;&lt;span class=&quot;&quot;&gt;。&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;ds-markdown-paragraph&quot; style=&quot;margin: 16px 0px; color: rgb(15, 17, 21); font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Open Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;span class=&quot;&quot;&gt;它的核心作用是&lt;/span&gt;&lt;strong style=&quot;font-weight: 600;&quot;&gt;&lt;span class=&quot;&quot;&gt;为 Radix Tree 的节点对象创建一个专用的内存缓存（slab cache），并初始化其内部管理结构，为后续内核使用 Radix Tree 管理数据做好准备&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;" id="Sgn_1HDSBjQnMq3442AB-84">
          <mxCell parent="1" style="text;whiteSpace=wrap;html=1;" vertex="1">
            <mxGeometry height="130" width="805" x="350" y="3965" as="geometry" />
          </mxCell>
        </UserObject>
